# Copy this file to .env before starting the local stack:
# cp .env.example .env

# OpenAI
# Keep the real key only in .env. Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# PostgreSQL
POSTGRES_DB=fraud_intelligence
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud_dev_password
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5

# Official agentgateway MCP endpoint
AGENTGATEWAY_PORT=3000
PATROL_PORT=10003

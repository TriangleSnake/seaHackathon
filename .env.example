# Copy this file to .env before starting the local stack:
# cp .env.example .env

# OpenAI
# Keep the real key only in .env. Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# PostgreSQL
POSTGRES_DB=fraud_intelligence
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud_dev_password
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5

# Official agentgateway MCP endpoint
AGENTGATEWAY_PORT=3000
AGENTGATEWAY_TIMEOUT_SECONDS=5
PATROL_PORT=10003
PATROL_MAX_CONCURRENCY=2
PATROL_SCHEDULER_POLL_SECONDS=15
ASSOCIATION_PORT=10004
ASSOCIATION_MAX_CONCURRENCY=2
ASSOCIATION_RESULT_URL=
ASSOCIATION_CALLBACK_TIMEOUT_SECONDS=10
ASSOCIATION_CALLBACK_MAX_ATTEMPTS=3
INVESTIGATION_PORT=10002
INVESTIGATION_URL=http://investigation:8000
INVESTIGATION_TIMEOUT_SECONDS=10
INVESTIGATION_MAX_ATTEMPTS=3
SCOREBOARD_CONFIG_VERSION=development-v1

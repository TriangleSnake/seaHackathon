{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investigation.schema.json",
  "title": "Investigation Contracts",
  "$defs": {
    "InvestigationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "detection_result",
        "scoreboard_config_ref"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "detection_result": {
          "$ref": "detection.schema.json#/$defs/DetectionResult"
        },
        "existing_evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Evidence"
          }
        },
        "scoreboard_config_ref": {
          "$ref": "scoreboard.schema.json#/$defs/ScoreboardConfigRef",
          "description": "Immutable reference to configuration stored by System. Limits are not supplied/decided by Investigation."
        }
      }
    },
    "AgentInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "case_type",
        "sequence",
        "routing_score",
        "reason"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "case_type": {
          "type": "string",
          "enum": ["order", "chat", "marketplace_info"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "routing_score": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "AgentItemScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type", "score", "confidence", "rationale", "evidence_refs"],
      "properties": {
        "item_type": {"type": "string", "minLength": 1},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "AgentAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings", "item_scores", "direct_evidence_found"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "findings": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/Finding"}
        },
        "item_scores": {
          "type": "array",
          "items": {"$ref": "#/$defs/AgentItemScore"}
        },
        "direct_evidence_found": {"type": "boolean"},
        "recommended_follow_up": {"type": ["string", "null"]}
      }
    },
    "WeightedItemContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type", "score", "confidence", "configured_weight", "effective_weight", "weighted_contribution", "evidence_refs"],
      "properties": {
        "item_type": {"type": "string"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "configured_weight": {"type": "number", "exclusiveMinimum": 0},
        "effective_weight": {"type": "number", "minimum": 0},
        "weighted_contribution": {"type": "number", "minimum": 0},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "AgentScoreAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weighted_score", "confidence", "coverage", "total_effective_weight", "contributions"],
      "properties": {
        "weighted_score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "total_effective_weight": {"type": "number", "exclusiveMinimum": 0},
        "contributions": {
          "type": "array",
          "items": {"$ref": "#/$defs/WeightedItemContribution"}
        }
      }
    },
    "SpecialistAgentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "raw_analysis", "score_aggregate", "rejected_item_scores"],
      "properties": {
        "agent": {"type": "string"},
        "raw_analysis": {"$ref": "#/$defs/AgentAnalysis"},
        "score_aggregate": {
          "oneOf": [
            {"$ref": "#/$defs/AgentScoreAggregate"},
            {"type": "null"}
          ]
        },
        "rejected_item_scores": {"type": "integer", "minimum": 0}
      }
    },
    "InvestigationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "subject",
        "verdict",
        "confidence",
        "summary",
        "findings",
        "evidence",
        "agents_invoked",
        "agent_results",
        "scoreboard",
        "stop_reason"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/Subject"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "fraud",
            "suspicious",
            "normal",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Finding"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Evidence"
          }
        },
        "agents_invoked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentInvocation"
          }
        },
        "agent_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecialistAgentResult"
          }
        },
        "scoreboard": {
          "$ref": "scoreboard.schema.json#/$defs/ScoreboardState"
        },
        "stop_reason": {
          "type": "string",
          "enum": [
            "direct_evidence",
            "fraud_threshold",
            "false_positive_evidence",
            "budget_exhausted",
            "diminishing_returns",
            "insufficient_evidence"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patrol.schema.json",
  "title": "Patrol Contracts",
  "$defs": {
    "PatrolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "mode",
        "scope"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "scheduled",
            "manual"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "exploit",
            "explore"
          ],
          "default": "exploit"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "account",
                  "shop",
                  "product",
                  "transaction",
                  "message"
                ]
              },
              "uniqueItems": true
            },
            "since": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      }
    },
    "ObservedSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "evidence_refs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "PatrolPolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "PatrolJobAccepted": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "status", "status_url"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["queued", "running", "completed", "failed"]},
        "status_url": {"type": "string", "minLength": 1}
      }
    },
    "PatrolJobState": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "status", "run_id", "strategy", "policy_ref", "created_at", "updated_at", "result", "error", "handoff_status", "handoff_attempts"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["queued", "running", "completed", "failed"]},
        "run_id": {"type": "string", "minLength": 1},
        "strategy": {"type": "string", "enum": ["exploit", "explore"]},
        "policy_ref": {"$ref": "#/$defs/PatrolPolicyRef"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "result": {"oneOf": [{"$ref": "#/$defs/PatrolResult"}, {"type": "null"}]},
        "error": {"type": ["string", "null"]},
        "handoff_status": {"type": "string", "enum": ["pending", "not_required", "delivered", "failed"]},
        "handoff_attempts": {"type": "integer", "minimum": 0}
      }
    },
    "PatrolDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "hypothesis",
        "reason",
        "observed_signals",
        "counter_signals",
        "priority",
        "evidence_refs"
      ],
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/Subject"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observed_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/ObservedSignal" },
          "minItems": 1
        },
        "counter_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "PatrolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "strategy",
        "policy_ref",
        "discoveries",
        "evidence"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "strategy": {
          "type": "string",
          "enum": ["exploit", "explore"]
        },
        "policy_ref": {
          "$ref": "#/$defs/PatrolPolicyRef"
        },
        "discoveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatrolDiscovery"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Evidence"
          }
        }
      }
    }
  }
}

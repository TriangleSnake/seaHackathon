{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detection.schema.json",
  "title": "Detection Contracts",
  "$defs": {
    "DetectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/Subject"
        },
        "trigger_context": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "patrol",
                "manual",
                "scheduled",
                "api"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "requested_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rule_based",
              "anomaly",
              "llm_classifier",
              "ml_classifier"
            ]
          },
          "uniqueItems": true
        },
        "policy_ref": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/PolicyRef"},
            {"properties": {"type": {"const": "detection"}}}
          ]
        }
      }
    },
    "DetectionTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "detector",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "detector": {
          "type": "string",
          "enum": [
            "rule_based",
            "anomaly",
            "llm_classifier",
            "ml_classifier"
          ]
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "raw_result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Detector-specific raw output, e.g. classifier label/logprobs. Not a system fraud score."
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "DetectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection_id",
        "subject",
        "policy_ref",
        "detected",
        "triggers",
        "evidence",
        "component_results"
      ],
      "properties": {
        "detection_id": {
          "type": "string"
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/Subject"
        },
        "policy_ref": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/PolicyRef"},
            {"properties": {"type": {"const": "detection"}}}
          ]
        },
        "detected": {
          "type": "boolean"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DetectionTrigger"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Evidence"
          }
        },
        "component_results": {
          "type": "array",
          "items": {"$ref": "#/$defs/ComponentResult"}
        }
      }
    },
    "ComponentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "detector", "version", "status", "trigger_count", "latency_ms"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "detector": {"type": "string", "enum": ["rule_based", "anomaly", "llm_classifier", "ml_classifier"]},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["completed", "abstained", "unavailable", "failed"]},
        "trigger_count": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
